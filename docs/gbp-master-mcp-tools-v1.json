{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contractVersion": "2.0.0",
  "serverName": "GBP Master",
  "serverInstructions": "Resolve locations before location-scoped actions. Show the exact content, targets and publication time and obtain confirmation before publishing, scheduling or cancelling. Never request or return authentication secrets.",
  "authentication": {
    "required": true,
    "identitySource": "OAuth access token request context",
    "oauthScopes": [
      "openid",
      "email",
      "profile",
      "offline_access"
    ],
    "permissionEnforcement": "GBP tool permissions are enforced by the MCP server. Supabase OAuth currently supports standard identity scopes rather than custom application scopes.",
    "forbiddenModelInputs": [
      "user_id",
      "google_access_token",
      "google_refresh_token",
      "google_account_id"
    ]
  },
  "scopes": {
    "openid": "Confirm the user's GBP Master identity.",
    "email": "Read the email address attached to the GBP Master account.",
    "profile": "Read basic GBP Master account profile information.",
    "offline_access": "Keep the approved AI connection working by securely refreshing its authorization."
  },
  "errors": {
    "authentication_required": "The GBP Master connection is missing or expired.",
    "permission_denied": "The signed-in user does not own the requested location or resource.",
    "google_reconnect_required": "The saved Google authorization is missing, expired, or revoked.",
    "resource_not_found": "The requested location, review, or scheduled post was not found.",
    "conflict": "The action was already completed or the resource changed since it was read.",
    "upstream_unavailable": "Google or another required service could not complete the request.",
    "delivery_uncertain": "The request may have reached Google; reconcile its status before retrying."
  },
  "tools": [
    {
      "name": "list_locations",
      "title": "List business locations",
      "description": "Use when the user wants to see or choose a connected Google Business Profile location. Returns only locations owned by the authenticated GBP Master account.",
      "authorization": [
        "gbp.locations.read"
      ],
      "confirmation": "never",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "location_id": {
                  "type": "string",
                  "pattern": "^locations/[A-Za-z0-9_-]+$"
                },
                "name": {
                  "type": "string"
                },
                "plan": {
                  "type": "string",
                  "enum": [
                    "free",
                    "monthly",
                    "half_yearly",
                    "yearly"
                  ]
                },
                "subscription_expires_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "account_id": {
                  "type": ["string", "null"]
                },
                "is_lifetime": {
                  "type": "boolean"
                },
                "unlimited_access": {
                  "type": "boolean"
                }
              },
              "required": [
                "location_id",
                "name",
                "plan",
                "subscription_expires_at"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "locations"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "list_reviews",
      "title": "List customer reviews",
      "description": "Use when the user wants to inspect Google reviews for one connected business location. It can return all reviews, only unanswered reviews, or only answered reviews.",
      "authorization": [
        "gbp.reviews.read"
      ],
      "confirmation": "never",
      "inputSchema": {
        "type": "object",
        "properties": {
          "location_id": {
            "type": "string",
            "pattern": "^locations/[A-Za-z0-9_-]+$"
          },
          "reply_status": {
            "type": "string",
            "enum": [
              "all",
              "unanswered",
              "answered"
            ],
            "default": "all"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          },
          "page_token": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          }
        },
        "required": [
          "location_id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "location_id": {
            "type": "string"
          },
          "reviews": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "review_id": {
                  "type": "string"
                },
                "reviewer_name": {
                  "type": "string"
                },
                "rating": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "comment": {
                  "type": "string"
                },
                "created_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "has_reply": {
                  "type": "boolean"
                },
                "reply_text": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "review_id",
                "reviewer_name",
                "rating",
                "comment",
                "created_at",
                "has_reply",
                "reply_text"
              ],
              "additionalProperties": false
            }
          },
          "next_page_token": {
            "type": [
              "string",
              "null"
            ]
          },
          "total_review_count": {
            "type": "integer",
            "minimum": 0
          },
          "average_rating": {
            "type": "number",
            "minimum": 0,
            "maximum": 5
          }
        },
        "required": [
          "location_id",
          "reviews",
          "next_page_token",
          "total_review_count",
          "average_rating"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "draft_review_reply",
      "title": "Draft a review reply",
      "description": "Use when the user wants a proposed reply for one unanswered review without publishing it. Uses the saved tone, keywords, and business instructions for the selected location.",
      "authorization": [
        "gbp.reviews.read"
      ],
      "confirmation": "never",
      "inputSchema": {
        "type": "object",
        "properties": {
          "location_id": {
            "type": "string",
            "pattern": "^locations/[A-Za-z0-9_-]+$"
          },
          "review_id": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "location_id",
          "review_id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "location_id": {
            "type": "string"
          },
          "review_id": {
            "type": "string"
          },
          "reviewer_name": {
            "type": "string"
          },
          "rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "review_comment": {
            "type": "string"
          },
          "draft_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "location_id",
          "review_id",
          "reviewer_name",
          "rating",
          "review_comment",
          "draft_text"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "publish_review_reply",
      "title": "Publish a review reply",
      "description": "Confirm the exact target and proposed action before publishing, scheduling or cancelling.",
      "authorization": [
        "gbp.reviews.write"
      ],
      "confirmation": "always",
      "inputSchema": {
        "type": "object",
        "properties": {
          "location_id": {
            "type": "string",
            "pattern": "^locations/[A-Za-z0-9_-]+$"
          },
          "review_id": {
            "type": "string",
            "maxLength": 500
          },
          "reply_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "location_id",
          "review_id",
          "reply_text"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "published"
            ]
          },
          "location_id": {
            "type": "string"
          },
          "review_id": {
            "type": "string"
          },
          "published_reply": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "location_id",
          "review_id",
          "published_reply"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "list_scheduled_posts",
      "title": "List scheduled posts",
      "description": "Use when the user wants to inspect upcoming or previous GBP Master calendar items for one connected business location.",
      "authorization": [
        "gbp.posts.read"
      ],
      "confirmation": "never",
      "inputSchema": {
        "type": "object",
        "properties": {
          "location_id": {
            "type": "string",
            "pattern": "^locations/[A-Za-z0-9_-]+$"
          },
          "status": {
            "type": "string",
            "enum": [
              "all",
              "scheduled",
              "publishing",
              "published",
              "failed"
            ],
            "default": "scheduled"
          },
          "from_time": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "to_time": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          }
        },
        "required": [
          "location_id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "posts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "post_id": {
                  "type": "string"
                },
                "location_id": {
                  "type": "string"
                },
                "scheduled_for": {
                  "type": "string",
                  "format": "date-time"
                },
                "caption": {
                  "type": "string"
                },
                "media_url": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uri"
                },
                "post_type": {
                  "type": "string",
                  "enum": [
                    "LOCAL_POST",
                    "PHOTO",
                    "VIDEO"
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "scheduled",
                    "publishing",
                    "published",
                    "failed"
                  ]
                }
              },
              "required": [
                "post_id",
                "location_id",
                "scheduled_for",
                "caption",
                "media_url",
                "post_type",
                "status"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "posts"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "schedule_post",
      "title": "Schedule a business post",
      "description": "Confirm the exact target and proposed action before publishing, scheduling or cancelling.",
      "authorization": [
        "gbp.posts.write"
      ],
      "confirmation": "always",
      "inputSchema": {
        "type": "object",
        "properties": {
          "location_id": {
            "type": "string",
            "pattern": "^locations/[A-Za-z0-9_-]+$"
          },
          "publish_at": {
            "type": "string",
            "format": "date-time"
          },
          "caption": {
            "type": "string",
            "maxLength": 1500
          },
          "post_type": {
            "type": "string",
            "enum": [
              "LOCAL_POST",
              "PHOTO",
              "VIDEO"
            ]
          },
          "media_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          }
        },
        "required": [
          "location_id",
          "publish_at",
          "caption",
          "post_type",
          "media_url"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "scheduled"
            ]
          },
          "post_id": {
            "type": "string"
          },
          "location_id": {
            "type": "string"
          },
          "scheduled_for": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "status",
          "post_id",
          "location_id",
          "scheduled_for"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "cancel_scheduled_post",
      "title": "Cancel a scheduled post",
      "description": "Confirm the exact target and proposed action before publishing, scheduling or cancelling.",
      "authorization": [
        "gbp.posts.write"
      ],
      "confirmation": "always",
      "inputSchema": {
        "type": "object",
        "properties": {
          "location_id": {
            "type": "string",
            "pattern": "^locations/[A-Za-z0-9_-]+$"
          },
          "post_id": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "location_id",
          "post_id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "cancelled"
            ]
          },
          "post_id": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "post_id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      }
    }
  ],
  "implementationGaps": [
    "Photo and video scheduling currently requires a durable public HTTPS media URL; direct MCP media upload is not yet implemented."
  ]
}
