SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...your_service_role_key...
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_MAPS_API_KEY=your_google_maps_key
GROQ_API_KEY=your_groq_key
SERPAPI_KEY=optional_for_admin_competitor_scan
ALLOWED_ORIGINS=https://www.gbpautomaster.in,https://gbpautomaster.in,http://localhost:5173
CRON_SECRET=generate_a_long_random_secret
BUSINESS_TIMEZONE=Asia/Kolkata
# Public canonical URL of the future streamable HTTP MCP endpoint.
MCP_RESOURCE_URL=https://gbp-auto-master-backend-us.onrender.com/mcp
MCP_DOCUMENTATION_URL=https://gbpautomaster.in/privacy
# Access codes are hashed in Supabase (migration 005); checkout is temporarily paused.
# Required only if Google Pub/Sub push notifications are enabled.
GOOGLE_PUBSUB_TOPIC=projects/your-project/topics/gbp-reviews
GOOGLE_PUBSUB_AUDIENCE=https://gbp-auto-master-backend-us.onrender.com/api/webhooks/google-reviews
GOOGLE_PUBSUB_SERVICE_ACCOUNT=your-pubsub-service-account@your-project.iam.gserviceaccount.com
# Stable Fernet key, generated once and backed up separately from the database.
CREDENTIAL_ENCRYPTION_KEY=
# Optional shared image provider. Keep Cloudflare on Workers Free for a hard
# provider-enforced allowance; a paid plan can incur usage charges.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Public Pollinations app identifier; users authorize their own provider budget.
POLLINATIONS_APP_KEY=
POLLINATIONS_REDIRECT_URI=https://gbpautomaster.in/image-connect
